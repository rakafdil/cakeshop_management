# Cakeshop API — konfigurasi environment
# Salin ke .env lalu sesuaikan.

PORT=4000
HOST=0.0.0.0

# PostgreSQL (lihat packages/database/.env juga)
DATABASE_URL=postgres://user:password@localhost:5432/cakeshop

# Auth: JWT disimpan di httpOnly cookie
JWT_SECRET=ganti-dengan-secret-panjang-minimal-16-karakter
JWT_EXPIRES_IN_DAYS=7

# true di production (HTTPS); false di localhost
COOKIE_SECURE=false

# Origin frontend (comma-separated jika lebih dari satu)
CORS_ORIGIN=http://localhost:3000

# Rate limit global (per IP, per window)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Rate limit khusus login (lebih ketat)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Data default untuk script seed (admin)
SEED_ADMIN_EMAIL=admin@cakeshop.local
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_NAME=Admin Cakeshop